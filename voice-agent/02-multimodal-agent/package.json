{
  "name": "stepfun-workshop-stage-2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "node --watch --import tsx src/server.ts",
    "start": "node --import tsx src/server.ts",
    "chat": "node --import tsx src/cli.ts",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "smoke": "node --import tsx scripts/smoke.ts",
    "smoke:production": "node --import tsx scripts/production-smoke.ts",
    "smoke:search": "node --import tsx scripts/search-smoke.ts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.71",
    "ai": "7.0.143",
    "dotenv": "^17.2.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
