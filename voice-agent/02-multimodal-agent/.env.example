# Stage 2 configuration: copy to this folder as .env if needed.
# Otherwise this stage also reads ../.env (the workshop root).
STEP_API_KEY=YOUR_STEPFUN_API_KEY
STEP_BASE_URL=https://api.stepfun.ai/v1
STEP_MODEL=step-5-preview

# Stage 2: separate audio generations, then a local Node.js mix.
STEP_AUDIO_MODEL=stepaudio-3-tts
STEP_AUDIO_MUSIC_MODEL=stepaudio-3-gen-preview
STEP_AUDIO_GEN_MODEL=stepaudio-3-gen-preview

# Optional alternative for music only: stepaudio-3-music-preview.
# It submits an async task; this service is not the default workshop path.

# Optional: enable Tavily web research after adding your own key.
TAVILY_API_KEY=
PORT=3210
